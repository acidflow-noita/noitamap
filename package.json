{
  "name": "noitamap",
  "version": "1.0.0",
  "description": "Noita Map",
  "main": "src/main.ts",
  "module": "src/main.ts",
  "scripts": {
    "preinstall": "git submodule update --init --recursive",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run sync-translations && npm run add-biome-translations && npm run bake-extended-translations && npm run generate-creature-data && npm run bake-creature-translations && npm run check-translations && npm run copy-flags && npm run copy-locales && npm run copy-telescope-data && npm run build-spritesheet && npm run generate-reaction-roles && npm run generate-material-effects && vite build",
    "check-poi-coverage": "vitest run tests/poi-name-coverage.test.ts tests/poi-sprite-coverage.test.ts tests/poi-item-emission-coverage.test.ts",
    "build-spritesheet": "node build_scripts/build-spritesheet.cjs",
    "generate-reaction-roles": "node build_scripts/generate-reaction-roles.cjs",
    "generate-material-effects": "node build_scripts/generate-material-effects.cjs",
    "generate-creature-data": "node build_scripts/generate-creature-data.cjs",
    "generate-perk-wiki": "node build_scripts/generate-perk-wiki.cjs",
    "bake-creature-translations": "node build_scripts/bake-creature-translations.cjs",
    "copy-flags": "node build_scripts/copy-flags.cjs",
    "copy-telescope-data": "node build_scripts/copy-telescope-data.cjs",
    "add-biome-translations": "node build_scripts/add-biome-translations.cjs",
    "bake-extended-translations": "node build_scripts/bake-extended-translations.cjs",
    "copy-locales": "node build_scripts/copy-locales.cjs",
    "check-translations": "node build_scripts/check-translations.cjs",
    "sync-translations": "node build_scripts/sync-translations.cjs",
    "watch": "vite build --watch",
    "dev": "vite",
    "generate": "node ./src/data/data_generators/map_definitions_maker.cjs",
    "test-telescope": "vitest run tests/telescope-integration.test.ts tests/telescope-wang-tiles.test.ts",
    "update-and-build": "node scripts/update-telescope.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acidflow-noita/noitamap.git"
  },
  "type": "module",
  "exports": {
    "./data_sources/tile_data": "./src/data_sources/tile_data.ts",
    "./data_sources/map_definitions": "./src/data_sources/map_definitions.ts",
    "./data_sources/param-mappings": "./src/data_sources/param-mappings.ts",
    "./data_sources/overlays": "./src/data_sources/overlays.ts",
    "./app_osd": "./src/app_osd.ts",
    "./util": "./src/util.ts",
    "./auth/auth-service": "./src/auth/auth-service.ts",
    "./i18n": "./src/i18n.ts",
    "./data-archive": "./src/data-archive.ts"
  },
  "files": [
    "src/",
    "global.d.ts"
  ],
  "keywords": [
    "Map",
    "Noita",
    "Noita",
    "Map",
    "Noitamap",
    "OpenseaDragon"
  ],
  "author": "WUOTE",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/acidflow-noita/noitamap/issues"
  },
  "homepage": "https://github.com/acidflow-noita/noitamap#readme",
  "dependencies": {
    "fast-png": "^8.0.0",
    "flatbush": "^4.5.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@designsystemsinternational/flags": "^0.2.0",
    "@emnapi/core": "^1.9.2",
    "@emnapi/runtime": "^1.9.2",
    "@napi-rs/canvas": "1.0.8",
    "@types/bootstrap": "^5.2.11",
    "@types/jsdom": "^28.0.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^25.9.2",
    "concurrently": "^9.2.1",
    "eventemitter2": "6.4.9",
    "flexsearch": "0.8.212",
    "idb": "^8.0.3",
    "jsdom": "^28.1.0",
    "koffi": "3.2.1",
    "lz-string": "^1.5.0",
    "openseadragon": "^6.1.0",
    "pixi.js": "^8.19.0",
    "playwright": "1.60.0",
    "prettier": "^3.8.1",
    "rollup": "^4.61.1",
    "sharp": "0.35.4",
    "simplify-js": "^1.2.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "koffi@3.2.1": true,
    "esbuild@0.28.2": true
  }
}
