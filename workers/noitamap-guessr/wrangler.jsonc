{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noitamap-guessr",
  "account_id": "3d75ffad634d443fca37da68c0ed4f3c",
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "guessr-api.sage-data.xyz", "custom_domain": true }],
  "vars": {
    "GAME_ENABLED": "true",
    "SOLO_ENABLED": "true",
    "STREAM_ENABLED": "true",
    "TWITCH_PLAYER_CLIENT_ID": "9wmgerb87z6v5i8yb1q5ggy2ya2khj",
    "STREAM_IMAGE_ROOT": "https://guessr-tiles.sage-data.xyz/images",
    "STREAM_REFERENCE_ROOT": "https://guessr-map.sage-data.xyz/map_files/",
    "DAILY_ASSET_HOSTS": "noitaguessr-tiles.pages.dev,noitaguessr-map.pages.dev",
    "ALLOWED_ORIGINS": "https://dynamic-map.noitamap.com",
    "DAILY_REQUEST_BUDGET": "10000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noitamap-guessr",
      "database_id": "0cf10a94-a762-43e7-88ec-866a319dc324",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "STREAM_COORDINATORS", "class_name": "StreamCoordinator" }] },
  "migrations": [
    { "tag": "live-rooms-v1", "new_sqlite_classes": ["LiveRoom"] },
    { "tag": "retire-live-rooms-v2", "deleted_classes": ["LiveRoom"] },
    { "tag": "stream-coordinator-v3", "new_sqlite_classes": ["StreamCoordinator"] }
  ],
  "ratelimits": [{ "name": "PUBLIC_GAME_RATE_LIMIT", "namespace_id": "111103", "simple": { "limit": 120, "period": 60 } }],
  "assets": {
    "directory": "../../task/guessr/private/worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "triggers": { "crons": ["15 0 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
