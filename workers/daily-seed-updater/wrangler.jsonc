{
  "name": "daily-seed-updater",
  "account_id": "666c045f38dd332e459bfe2a18c4e9a9",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  // Cron trigger: 00:01 UTC daily. Seed changes at midnight UTC.
  "triggers": {
    "crons": ["1 0 * * *"],
  },
  // Both defaults must be disabled explicitly; no public HTTP endpoint.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "SEED_WORKER_NAME": "daily-seed-serve",
  },
  // Secrets Store bindings — same store as noitamap-auth.
  // Add NOITAMAP_SEED_DEPLOY_TOKEN, CF_ACCOUNT_ID and GITLAB_BIOME_BAKER_TRIGGER_TOKEN to
  // store ID 291b9519666945a1a56adbb686c62d76.
  "secrets_store_secrets": [
    {
      "binding": "CF_API_TOKEN",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_SEED_DEPLOY_TOKEN",
    },
    {
      "binding": "CF_ACCOUNT_ID",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "CF_ACCOUNT_ID",
    },
    {
      "binding": "GITLAB_BIOME_BAKER_TRIGGER_TOKEN",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "GITLAB_BIOME_BAKER_TRIGGER_TOKEN",
    },
  ],
}
