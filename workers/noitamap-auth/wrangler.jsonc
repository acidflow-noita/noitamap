// Production accepts only the hardened dynamic-map client. Add noitamap.com at cutover.
// OAuth query codes must not enter invocation logs or traces. Only explicit safe events are logged.
// Dev/local are disabled until independent OAuth apps, keys and storage are configured.
// LEGACY_CREDENTIAL_SECRET decrypts provider data only, never old sessions. Remove after migration.
{
  "name": "noitamap-auth",
  "account_id": "666c045f38dd332e459bfe2a18c4e9a9",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-20",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "WORKER_URL": "https://noitamap-auth.wuote.workers.dev",
    "ALLOWED_ORIGINS": "https://dynamic-map.noitamap.com",
    "AUTH_ENABLED": "true",
    "CREDENTIAL_KEY_ID": "1",
    "TWITCH_PRO_USER_IDS": "564553302,241636"
  },
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "noitamap-auth-accounts",
      "database_id": "843b3e88-230d-4912-8b7d-d1bcdb5b5d2d",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TWITCH_TOKEN_STORE",
      "id": "7be2bbc4b8bd4b7b9d4ede511756ff92"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "PATREON_CLIENT_ID",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "PATREON_CLIENT_ID"
    },
    {
      "binding": "PATREON_CLIENT_SECRET",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "PATREON_CLIENT_SECRET"
    },
    {
      "binding": "PATREON_CAMPAIGN_ID",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "PATREON_CAMPAIGN_ID"
    },
    {
      "binding": "CREATOR_USER_ID",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "CREATOR_USER_ID"
    },
    {
      "binding": "TWITCH_CLIENT_ID",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_TWITCH_CLIENT_ID"
    },
    {
      "binding": "TWITCH_CLIENT_SECRET",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_TWITCH_CLIENT_SECRET"
    },
    {
      "binding": "TWITCH_BROADCASTER_ID",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_TWITCH_BROADCASTER_ID"
    },
    {
      "binding": "TWITCH_BROADCASTER_REFRESH_TOKEN",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_TWITCH_BROADCASTER_REFRESH_TOKEN"
    },
    {
      "binding": "SESSION_SIGNING_SECRET",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_SESSION_SIGNING_SECRET"
    },
    {
      "binding": "CREDENTIAL_ENCRYPTION_SECRET",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "NOITAMAP_CREDENTIAL_ENCRYPTION_SECRET"
    },
    {
      "binding": "LEGACY_CREDENTIAL_SECRET",
      "store_id": "291b9519666945a1a56adbb686c62d76",
      "secret_name": "JWT_SECRET_PROD"
    }
  ],
  "env": {
    "dev": {
      "name": "noitamap-auth-dev",
      "d1_databases": [
        {
          "binding": "ACCOUNT_DB",
          "database_name": "noitamap-auth-accounts-dev",
          "database_id": "458cdca7-305e-468b-8072-18bb3d05d142",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "WORKER_URL": "https://noitamap-auth-dev.wuote.workers.dev",
        "AUTH_ENABLED": "false",
        "ALLOWED_ORIGINS": "https://dev.noitamap.com",
        "CREDENTIAL_KEY_ID": "dev-1",
        "TWITCH_PRO_USER_IDS": ""
      },
      "kv_namespaces": [],
      "secrets_store_secrets": [],
      "ratelimits": [],
      "triggers": {
        "crons": []
      },
      "preview_urls": false
    },
    "local": {
      "name": "noitamap-auth-local",
      "vars": {
        "WORKER_URL": "http://localhost:8787",
        "AUTH_ENABLED": "false",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173",
        "CREDENTIAL_KEY_ID": "dev-1",
        "TWITCH_PRO_USER_IDS": ""
      },
      "kv_namespaces": [],
      "secrets_store_secrets": [],
      "ratelimits": [],
      "triggers": {
        "crons": []
      },
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "ACCOUNT_DB",
          "database_name": "noitamap-auth-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "remote": false
        }
      ]
    }
  },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 5 * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "111101",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "SESSION_RATE_LIMIT",
      "namespace_id": "111102",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
